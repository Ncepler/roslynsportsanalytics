# Google AI Studio / Gemini API key. Server-only.
GEMINI_API_KEY=
# Gemini model id used for video analysis (check current names in Google's docs).
GEMINI_MODEL=
# "free" or "paid". "free" shows the don't-upload-student-footage banner.
GEMINI_TIER=free
# Anthropic API key for the Season tab write-ups. Server-only.
ANTHROPIC_API_KEY=
# Claude model id for the Season tab (check current names in Anthropic's docs).
CLAUDE_MODEL=
# Shared club password. Empty or unset means password login always fails.
CLUB_PASSWORD=
# "true" shows the Test button and accepts test logins. Set "false" before using a paid key.
ALLOW_TEST_LOGIN=false
# Random secret (32+ chars) that signs the session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=
# Owner-only unlock for the Roslyn-game check (CLAUDE.md section 3, rule 9). Leave empty to disable.
ADMIN_BYPASS_CODE=
# Admin (schedule page). Empty ADMIN_PASSWORD means password admin login always fails.
ADMIN_PASSWORD=
# "true" shows the Admin test button on the login page. Set "false" once ADMIN_PASSWORD is in use.
ALLOW_ADMIN_TEST=false

# Added automatically when a Vercel Blob store is connected to the project. Holds the temporary video hand-off and,
# under data/, the schedule and saved games. The store must be PRIVATE (saved games are about students).
BLOB_READ_WRITE_TOKEN=
